package(default_visibility = ["//visibility:public"])
exports_files([
    "Kconfig",
    "Makefile",
    "version-timestamp.c",
])



# Every header of this package its TUs can reach (Bazel only puts
# declared files in the compile sandbox); hdrs alone add no include
# root, so nothing is shadowed.
cc_library(
    name = "init_headers",
    hdrs = glob([
        "**/*.h",
        "**/*.hh",
        "**/*.hpp",
        "**/*.hxx",
        "**/*.inc",
        "**/*.inl",
        "**/*.ipp",
    ], exclude = ["version-timestamp.c"], allow_empty = True),
    textual_hdrs = ["version-timestamp.c"],
)

# the object(s) of `init_built_in` a recipe reads, at the paths it names
cc_object_files(
    name = "init_built_in_objects",
    lib = ":init_built_in",
    objects = [
        "calibrate.o",
        "do_mounts.o",
        "do_mounts_initrd.o",
        "init_task.o",
        "initramfs.o",
        "main.o",
        "version.o",
    ],
)

# the object(s) of `init_version_timestamp` a recipe reads, at the paths it names
cc_object_files(
    name = "init_version_timestamp_objects",
    lib = ":init_version_timestamp",
    objects = ["version-timestamp.o"],
)

