"""A Kbuild offsets header: a C struct's field offsets as `#define`s.

Kbuild's `offsets` step (scripts/Makefile.lib's `sed-offsets` over an
`asm-offsets.s`-style file) turns the `.ascii` and `.->` lines an offsets
compilation emits into a header:

    offsets_header(
        name = "asm_offsets_h",
        src = "//arch/x86/kernel:asm-offsets.s",
        outs = ["include/generated/asm-offsets.h"],
        guard = "__ASM_OFFSETS_H__",
    )

The sed that reads the `.s` is Kbuild's own (scripts/Makefile.lib's
`sed-offsets`). The header is rewritten only when its bytes change, so the
generated tree's stamps survive a no-op build.
"""

# scripts/Makefile.lib's `sed-offsets`, verbatim.
_SED_OFFSETS = r"""'s:^[[:space:]]*\.ascii[[:space:]]*"\(.*\)".*:\1:; /^->/{s:->#\(.*\):/* \1 */:; s:^->\([^ ]*\) [\$#]*\([^ ]*\) \(.*\):#define \1 \2 /* \3 */:; s:->::; p;}'"""

def _offsets_header_impl(ctx):
    src = ctx.file.src
    out = ctx.outputs.outs[0]
    dir = out.path[:out.path.rfind("/")]
    tmp = "%s/.tmp_%s" % (dir, out.basename)
    guard = ctx.attr.guard
    ctx.actions.run_shell(
        inputs = [src],
        outputs = ctx.outputs.outs,
        command = (
            "set -e; mkdir -p %s; trap \"rm -f %s\" EXIT; " +
            "{ echo \"#ifndef %s\"; echo \"#define %s\"; echo \"/*\"; " +
            "echo \" * DO NOT MODIFY.\"; echo \" *\"; " +
            "echo \" * This file was generated by Kbuild\"; echo \" */\"; " +
            "echo \"\"; sed -ne %s < %s; echo \"\"; echo \"#endif\"; } > %s; " +
            "if [ ! -r %s ] || ! cmp -s %s %s; then " +
            "echo '  UPD     %s'; mv -f %s %s; fi"
        ) % (dir, tmp, guard, guard, _SED_OFFSETS, src.path, tmp,
             out.path, out.path, tmp, out.path, tmp, out.path),
        mnemonic = "Genrule",
        progress_message = "Offsets header %s" % out.short_path,
    )
    return [DefaultInfo(files = depset(ctx.outputs.outs))]

offsets_header = rule(
    implementation = _offsets_header_impl,
    attrs = {
        "guard": attr.string(mandatory = True,
                             doc = "the include guard of the header"),
        "src": attr.label(mandatory = True, allow_single_file = True,
                          doc = "the offsets `.s` the sed reads"),
        "outs": attr.output_list(mandatory = True,
                                 doc = "the header, as a path under the package"),
    },
    doc = "A Kbuild offsets header (see the module docstring).",
)
