# drivers/video: BUILD.bazel emitted by any2bazel emit_build.py from the reference model.
#
# Derived mechanically from model.capture.json (re-run the emitter
# rather than editing the derived parts by hand; the differ is the oracle):
#   drivers_video_built-in (static_library) -> cc_library drivers_video_built_in
#
# Notes:
#   - `drivers_video_built-in`: the reference built drivers/video/built-in.a with its own ar
#     recipe; it is a genrule over the captured argv (the member order is the link order), not
#     an aggregate merged in Bazel's order
#   - `drivers_video_built_in`: TUs whose argvs differ only in Kbuild's per-object defines ->
#     one cc_per_source_library; the defines ride the per-source map (the rule computes what its
#     arithmetic can)
#   - drivers_video_built_in_a: the ar recipe runs as an ar_archive rule (5 member(s))
load("//bazel/rules:ar_archive.bzl", "ar_archive")
load("//bazel/rules:cc_object_files.bzl", "cc_object_files")
load("//bazel/rules:cc_per_source_library.bzl", "cc_per_source_library")
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])
exports_files([
    "Kconfig",
])


# Every header of this package its TUs can reach (Bazel only puts
# declared files in the compile sandbox); hdrs alone add no include
# root, so nothing is shadowed.
cc_library(
    name = "video_headers",
    hdrs = glob([
        "**/*.h",
        "**/*.hh",
        "**/*.hpp",
        "**/*.hxx",
        "**/*.inc",
        "**/*.inl",
        "**/*.ipp",
    ], allow_empty = True),
)

# the object(s) of `drivers_video_built_in` a recipe reads, at the paths it names
cc_object_files(
    name = "drivers_video_built_in_objects",
    lib = ":drivers_video_built_in",
    objects = [
        "screen_info_generic.o",
        "screen_info_pci.o",
    ],
)

# the reference's own ar recipe: members in its order, which is
# the link order (an aggregate's merge order is Bazel's, not the
# reference's)
ar_archive(
    name = "drivers_video_built_in_a",
    out = "built-in.a",
    op = "cDPrST",
    members = [
        "screen_info_generic.o",
        "screen_info_pci.o",
        "//drivers/video/console:drivers_video_console_built_in_a",
        "//drivers/video/backlight:drivers_video_backlight_built_in_a",
        "//drivers/video/fbdev:drivers_video_fbdev_built_in_a",
    ],
    srcs = [
        "screen_info_generic.o",
        "screen_info_pci.o",
        "//drivers/video/console:drivers_video_console_built_in_a",
        "//drivers/video/backlight:drivers_video_backlight_built_in_a",
        "//drivers/video/fbdev:drivers_video_fbdev_built_in_a",
        "//drivers/video/console:vgacon.o",
        "//drivers/video/console:dummycon.o",
    ],
    ar = "@kernel_llvm//:bin/llvm-ar",
)

# CMake `drivers_video_built-in` (static library)
# sources with flags of their own (a define or two each): per_source_copts
# per-source KBUILD_* defines computed from the sources (kbuild); the map, when it remains, is what the arithmetic cannot express
cc_per_source_library(
    name = "drivers_video_built_in",
    srcs = [
        "screen_info_generic.c",
        "screen_info_pci.c",
    ],
    copts = [
        "-Idrivers/video",
        "-I$(GENDIR)",
    ],
    deps = [
        ":video_headers",
        "//:pkg_headers",
        "//:pkg_generated_under_arch_x86__include_generated_2",
        "//drivers:drivers_headers",
    ],
    features = ["kernel_compile_flags"],
    kbuild = "screen_info",
)
