# drivers/input: BUILD.bazel emitted by any2bazel emit_build.py from the reference model.
#
# Derived mechanically from model.capture.json (re-run the emitter
# rather than editing the derived parts by hand; the differ is the oracle):
#   drivers_input_built-in (static_library) -> cc_library drivers_input_built_in
load("//bazel/rules:ar_archive.bzl", "ar_archive")
load("//bazel/rules:cc_object_files.bzl", "cc_object_files")
load("//bazel/rules:cc_per_source_library.bzl", "cc_per_source_library")
load("//bazel/rules:cc_raw_link.bzl", "cc_raw_link")
load("//bazel/rules:tree_recipe.bzl", "tree_recipe")
load("@rules_cc//cc:cc_static_library.bzl", "cc_static_library")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")

package(default_visibility = ["//visibility:public"])
exports_files([
    "Kconfig",
])


# Every header of this package its TUs can reach (Bazel only puts
# declared files in the compile sandbox); hdrs alone add no include
# root, so nothing is shadowed.
cc_library(
    name = "input_headers",
    hdrs = glob([
        "**/*.h",
        "**/*.hh",
        "**/*.hpp",
        "**/*.hxx",
        "**/*.inc",
        "**/*.inl",
        "**/*.ipp",
    ], allow_empty = True),
)

# the object(s) of `drivers_input_built_in` a recipe reads, at the paths it names
cc_object_files(
    name = "drivers_input_built_in_objects",
    lib = ":drivers_input_built_in",
    objects = [
        "ff-core.o",
        "input-compat.o",
        "input-mt.o",
        "input-poller.o",
        "input.o",
        "touch-overlay.o",
        "touchscreen.o",
        "vivaldi-fmap.o",
    ],
)

# the reference's own ar recipe: members in its order, which is
# the link order (an aggregate's merge order is Bazel's, not the
# reference's)
ar_archive(
    name = "drivers_input_built_in_a",
    out = "built-in.a",
    op = "cDPrST",
    members = [
        "input.o",
        "input-compat.o",
        "input-mt.o",
        "input-poller.o",
        "ff-core.o",
        "touchscreen.o",
        "touch-overlay.o",
        "vivaldi-fmap.o",
        "//drivers/input/keyboard:drivers_input_keyboard_built_in_a",
        "//drivers/input/mouse:drivers_input_mouse_built_in_a",
    ],
    srcs = [
        "input.o",
        "input-compat.o",
        "input-mt.o",
        "input-poller.o",
        "ff-core.o",
        "touchscreen.o",
        "touch-overlay.o",
        "vivaldi-fmap.o",
        "//drivers/input/keyboard:drivers_input_keyboard_built_in_a",
        "//drivers/input/mouse:drivers_input_mouse_built_in_a",
        "//drivers/input/keyboard:atkbd.o",
        "//drivers/input/mouse:cypress_ps2.o",
        "//drivers/input/mouse:trackpoint.o",
        "//drivers/input/mouse:logips2pp.o",
        "//drivers/input/mouse:byd.o",
        "//drivers/input/mouse:alps.o",
        "//drivers/input/mouse:focaltech.o",
        "//drivers/input/mouse:synaptics.o",
        "//drivers/input/mouse:psmouse-base.o",
    ],
    ar = "@kernel_llvm//:bin/llvm-ar",
)

# CMake `drivers_input_built-in` (static library)
# sources with flags of their own (a define or two each): per_source_copts
# per-source KBUILD_* defines computed from the sources (kbuild); the map, when it remains, is what the arithmetic cannot express
cc_per_source_library(
    name = "drivers_input_built_in",
    srcs = [
        "ff-core.c",
        "input-compat.c",
        "input-mt.c",
        "input-poller.c",
        "input.c",
        "touch-overlay.c",
        "touchscreen.c",
        "vivaldi-fmap.c",
    ],
    copts = [
        "-Idrivers/input",
        "-I$(GENDIR)",
    ],
    deps = [
        ":input_headers",
        "//:pkg_headers",
        "//:pkg_generated_under_arch_x86__include_generated_2",
        "//drivers:drivers_headers",
    ],
    features = ["kernel_compile_flags"],
    kbuild = "built-in",
    kbuild_modules = {
        "input-core": [
            "ff-core.c",
            "input-compat.c",
            "input-mt.c",
            "input-poller.c",
            "input.c",
            "touch-overlay.c",
            "touchscreen.c",
        ],
    },
)
