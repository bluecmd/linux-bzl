# drivers/input/mouse: BUILD.bazel emitted by any2bazel emit_build.py from the reference model.
#
# Derived mechanically from model.capture.json (re-run the emitter
# rather than editing the derived parts by hand; the differ is the oracle):
#   drivers_input_mouse_built-in (static_library) -> cc_library drivers_input_mouse_built_in
load("//bazel/rules:ar_archive.bzl", "ar_archive")
load("//bazel/rules:cc_object_files.bzl", "cc_object_files")
load("//bazel/rules:cc_per_source_library.bzl", "cc_per_source_library")
load("//bazel/rules:cc_raw_link.bzl", "cc_raw_link")
load("//bazel/rules:tree_recipe.bzl", "tree_recipe")
load("@rules_cc//cc:cc_static_library.bzl", "cc_static_library")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")

package(default_visibility = ["//visibility:public"])
exports_files([
    "Kconfig",
])


# Every header of this package its TUs can reach (Bazel only puts
# declared files in the compile sandbox); hdrs alone add no include
# root, so nothing is shadowed.
cc_library(
    name = "mouse_headers",
    hdrs = glob([
        "**/*.h",
        "**/*.hh",
        "**/*.hpp",
        "**/*.hxx",
        "**/*.inc",
        "**/*.inl",
        "**/*.ipp",
    ], allow_empty = True),
)

# the object(s) of `drivers_input_mouse_built_in` a recipe reads, at the paths it names
cc_object_files(
    name = "drivers_input_mouse_built_in_objects",
    lib = ":drivers_input_mouse_built_in",
    objects = [
        "alps.o",
        "byd.o",
        "cypress_ps2.o",
        "focaltech.o",
        "logips2pp.o",
        "psmouse-base.o",
        "synaptics.o",
        "trackpoint.o",
    ],
)

# the reference's own ar recipe: members in its order, which is
# the link order (an aggregate's merge order is Bazel's, not the
# reference's)
ar_archive(
    name = "drivers_input_mouse_built_in_a",
    out = "built-in.a",
    op = "cDPrST",
    members = [
        "psmouse-base.o",
        "synaptics.o",
        "focaltech.o",
        "alps.o",
        "byd.o",
        "logips2pp.o",
        "trackpoint.o",
        "cypress_ps2.o",
    ],
    srcs = [
        "psmouse-base.o",
        "synaptics.o",
        "focaltech.o",
        "alps.o",
        "byd.o",
        "logips2pp.o",
        "trackpoint.o",
        "cypress_ps2.o",
    ],
    ar = "@kernel_llvm//:bin/llvm-ar",
)

# CMake `drivers_input_mouse_built-in` (static library)
# sources with flags of their own (a define or two each): per_source_copts
# per-source KBUILD_* defines computed from the sources (kbuild); the map, when it remains, is what the arithmetic cannot express
cc_per_source_library(
    name = "drivers_input_mouse_built_in",
    srcs = [
        "alps.c",
        "byd.c",
        "cypress_ps2.c",
        "focaltech.c",
        "logips2pp.c",
        "psmouse-base.c",
        "synaptics.c",
        "trackpoint.c",
    ],
    copts = [
        "-Idrivers/input/mouse",
        "-DKBUILD_MODFILE=\\\"drivers/input/mouse/psmouse\\\"",
        "-DKBUILD_MODNAME=\\\"psmouse\\\"",
        "-D__KBUILD_MODNAME=psmouse",
        "-I$(GENDIR)",
    ],
    deps = [
        ":mouse_headers",
        "//:pkg_headers",
        "//:pkg_generated_under_arch_x86__include_generated_2",
        "//drivers:drivers_headers",
    ],
    features = ["kernel_compile_flags"],
    kbuild = "module",
)
