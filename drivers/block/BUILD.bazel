# drivers/block: BUILD.bazel emitted by any2bazel emit_build.py from the reference model.
#
# Derived mechanically from model.capture.json (re-run the emitter
# rather than editing the derived parts by hand; the differ is the oracle):
#   drivers_block_built-in (static_library) -> cc_library drivers_block_built_in
#
# Notes:
#   - `drivers_block_built-in`: the reference built drivers/block/built-in.a with its own ar
#     recipe; it is a genrule over the captured argv (the member order is the link order), not
#     an aggregate merged in Bazel's order
#   - drivers_block_built_in_a: the ar recipe runs as an ar_archive rule (1 member(s))
load("//bazel/rules:cc_object_files.bzl", "cc_object_files")
load("//bazel/rules:kernel_library.bzl", "kernel_library")
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])
exports_files([
    "Kconfig",
])


# Every header of this package its TUs can reach (Bazel only puts
# declared files in the compile sandbox); hdrs alone add no include
# root, so nothing is shadowed.
cc_library(
    name = "block_headers",
    hdrs = glob([
        "**/*.h",
        "**/*.hh",
        "**/*.hpp",
        "**/*.hxx",
        "**/*.inc",
        "**/*.inl",
        "**/*.ipp",
    ], allow_empty = True),
)

# the object(s) of `drivers_block_built_in` a recipe reads, at the paths it names
cc_object_files(
    name = "drivers_block_built_in_objects",
    lib = ":drivers_block_built_in",
    objects = ["virtio_blk.o"],
)

# the library, its archive (the reference's own ar recipe: members
# in its order, which is the link order) and the objects a recipe
# reads by path: the macro owns the archive
kernel_library(
    name = "drivers_block_built_in",
    srcs = ["virtio_blk.c"],
    copts = [
        "-Idrivers/block",
        "-DKBUILD_MODFILE=\\\"drivers/block/virtio_blk\\\"",
        "-DKBUILD_BASENAME=\\\"virtio_blk\\\"",
        "-DKBUILD_MODNAME=\\\"virtio_blk\\\"",
        "-D__KBUILD_MODNAME=virtio_blk",
        "-I$(GENDIR)",
    ],
    deps = [
        "//drivers/s390/block:block_headers",
        "//:pkg_headers",
        "//:pkg_generated_under_arch_x86__include_generated_2",
        "//drivers:drivers_headers",
    ],
    features = ["kernel_compile_flags"],
    out = "built-in.a",
    op = "cDPrST",
    members = ["virtio_blk.o"],
    ar = "@kernel_llvm//:bin/llvm-ar",
)
