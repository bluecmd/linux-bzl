# drivers/misc: BUILD.bazel emitted by any2bazel emit_build.py from the reference model.
#
# Derived mechanically from model.capture.json (re-run the emitter
# rather than editing the derived parts by hand; the differ is the oracle):
#
# Notes:
#   - `drivers_misc_built-in`: the reference built drivers/misc/built-in.a with its own ar
#     recipe; it is a genrule over the captured argv (the member order is the link order), not
#     an aggregate merged in Bazel's order
load("//bazel/rules:ar_archive.bzl", "ar_archive")
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])
exports_files([
    "Kconfig",
])


# Every header of this package its TUs can reach (Bazel only puts
# declared files in the compile sandbox); hdrs alone add no include
# root, so nothing is shadowed.
cc_library(
    name = "misc_headers",
    hdrs = glob([
        "**/*.h",
        "**/*.hh",
        "**/*.hpp",
        "**/*.hxx",
        "**/*.inc",
        "**/*.inl",
        "**/*.ipp",
    ], allow_empty = True),
)

# the reference's own ar recipe: members in its order, which is
# the link order (an aggregate's merge order is Bazel's, not the
# reference's)
ar_archive(
    name = "drivers_misc_built_in_a",
    out = "built-in.a",
    op = "cDPrST",
    members = [
        "//drivers/misc/eeprom:drivers_misc_eeprom_built_in_a",
        "//drivers/misc/cb710:drivers_misc_cb710_built_in_a",
        "//drivers/misc/lis3lv02d:drivers_misc_lis3lv02d_built_in_a",
        "//drivers/misc/cardreader:drivers_misc_cardreader_built_in_a",
        "//drivers/misc/keba:drivers_misc_keba_built_in_a",
        "//drivers/misc/amd-sbi:drivers_misc_amd_sbi_built_in_a",
    ],
    srcs = [
        "//drivers/misc/eeprom:drivers_misc_eeprom_built_in_a",
        "//drivers/misc/cb710:drivers_misc_cb710_built_in_a",
        "//drivers/misc/lis3lv02d:drivers_misc_lis3lv02d_built_in_a",
        "//drivers/misc/cardreader:drivers_misc_cardreader_built_in_a",
        "//drivers/misc/keba:drivers_misc_keba_built_in_a",
        "//drivers/misc/amd-sbi:drivers_misc_amd_sbi_built_in_a",
        "//drivers/misc/eeprom:eeprom_93cx6.o",
    ],
    ar = "@kernel_llvm//:bin/llvm-ar",
)
