# drivers/misc/eeprom: BUILD.bazel emitted by any2bazel emit_build.py from the reference model.
#
# Derived mechanically from model.capture.json (re-run the emitter
# rather than editing the derived parts by hand; the differ is the oracle):
#   drivers_misc_eeprom_built-in (static_library) -> cc_library drivers_misc_eeprom_built_in
load("//bazel/rules:cc_object_files.bzl", "cc_object_files")
load("//bazel/rules:kernel_library.bzl", "kernel_library")
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])
exports_files([
    "Kconfig",
])


# Every header of this package its TUs can reach (Bazel only puts
# declared files in the compile sandbox); hdrs alone add no include
# root, so nothing is shadowed.
cc_library(
    name = "eeprom_headers",
    hdrs = glob([
        "**/*.h",
        "**/*.hh",
        "**/*.hpp",
        "**/*.hxx",
        "**/*.inc",
        "**/*.inl",
        "**/*.ipp",
    ], allow_empty = True),
)

# the object(s) of `drivers_misc_eeprom_built_in` a recipe reads, at the paths it names
cc_object_files(
    name = "drivers_misc_eeprom_built_in_objects",
    lib = ":drivers_misc_eeprom_built_in",
    objects = ["eeprom_93cx6.o"],
)

# the library, its archive (the reference's own ar recipe: members
# in its order, which is the link order) and the objects a recipe
# reads by path: the macro owns the archive
kernel_library(
    name = "drivers_misc_eeprom_built_in",
    srcs = ["eeprom_93cx6.c"],
    copts = [
        "-Idrivers/misc/eeprom",
        "-DKBUILD_MODFILE=\\\"drivers/misc/eeprom/eeprom_93cx6\\\"",
        "-DKBUILD_BASENAME=\\\"eeprom_93cx6\\\"",
        "-DKBUILD_MODNAME=\\\"eeprom_93cx6\\\"",
        "-D__KBUILD_MODNAME=eeprom_93cx6",
        "-I$(GENDIR)",
    ],
    deps = [
        ":eeprom_headers",
        "//:pkg_headers",
        "//:pkg_generated_under_arch_x86__include_generated_2",
        "//drivers:drivers_headers",
    ],
    features = ["kernel_compile_flags"],
    out = "built-in.a",
    op = "cDPrST",
    members = ["eeprom_93cx6.o"],
    ar = "@kernel_llvm//:bin/llvm-ar",
)
