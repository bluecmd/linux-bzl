# drivers/media/usb: BUILD.bazel emitted by any2bazel emit_build.py from the reference model.
#
# Derived mechanically from model.capture.json (re-run the emitter
# rather than editing the derived parts by hand; the differ is the oracle):
#
# Notes:
#   - `drivers_media_usb_built-in`: the reference built drivers/media/usb/built-in.a with its
#     own ar recipe; it is a genrule over the captured argv (the member order is the link
#     order), not an aggregate merged in Bazel's order
load("//bazel/rules:ar_archive.bzl", "ar_archive")
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])
exports_files([
    "Kconfig",
])


# Every header of this package its TUs can reach (Bazel only puts
# declared files in the compile sandbox); hdrs alone add no include
# root, so nothing is shadowed.
cc_library(
    name = "usb_headers",
    hdrs = glob([
        "**/*.h",
        "**/*.hh",
        "**/*.hpp",
        "**/*.hxx",
        "**/*.inc",
        "**/*.inl",
        "**/*.ipp",
    ], allow_empty = True),
)

# the reference's own ar recipe: members in its order, which is
# the link order (an aggregate's merge order is Bazel's, not the
# reference's)
ar_archive(
    name = "drivers_media_usb_built_in_a",
    out = "built-in.a",
    op = "cDPrST",
    members = [
        "//drivers/media/usb/b2c2:drivers_media_usb_b2c2_built_in_a",
        "//drivers/media/usb/dvb-usb:drivers_media_usb_dvb_usb_built_in_a",
        "//drivers/media/usb/dvb-usb-v2:drivers_media_usb_dvb_usb_v2_built_in_a",
        "//drivers/media/usb/s2255:drivers_media_usb_s2255_built_in_a",
        "//drivers/media/usb/siano:drivers_media_usb_siano_built_in_a",
        "//drivers/media/usb/ttusb-budget:drivers_media_usb_ttusb_budget_built_in_a",
        "//drivers/media/usb/ttusb-dec:drivers_media_usb_ttusb_dec_built_in_a",
    ],
    srcs = [
        "//drivers/media/usb/b2c2:drivers_media_usb_b2c2_built_in_a",
        "//drivers/media/usb/dvb-usb:drivers_media_usb_dvb_usb_built_in_a",
        "//drivers/media/usb/dvb-usb-v2:drivers_media_usb_dvb_usb_v2_built_in_a",
        "//drivers/media/usb/s2255:drivers_media_usb_s2255_built_in_a",
        "//drivers/media/usb/siano:drivers_media_usb_siano_built_in_a",
        "//drivers/media/usb/ttusb-budget:drivers_media_usb_ttusb_budget_built_in_a",
        "//drivers/media/usb/ttusb-dec:drivers_media_usb_ttusb_dec_built_in_a",
    ],
    ar = "@kernel_llvm//:bin/llvm-ar",
)
