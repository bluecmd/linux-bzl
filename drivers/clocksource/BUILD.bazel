# drivers/clocksource: BUILD.bazel emitted by any2bazel emit_build.py from the reference model.
#
# Derived mechanically from model.capture.json (re-run the emitter
# rather than editing the derived parts by hand; the differ is the oracle):
#   drivers_clocksource_built-in (static_library) -> cc_library drivers_clocksource_built_in
#
# Notes:
#   - `drivers_clocksource_built-in`: the reference built drivers/clocksource/built-in.a with
#     its own ar recipe; it is a genrule over the captured argv (the member order is the link
#     order), not an aggregate merged in Bazel's order
#   - drivers_clocksource_built_in_a: the ar recipe runs as an ar_archive rule (1 member(s))
load("//bazel/rules:cc_object_files.bzl", "cc_object_files")
load("//bazel/rules:kernel_library.bzl", "kernel_library")
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])
exports_files([
    "Kconfig",
])


# Every header of this package its TUs can reach (Bazel only puts
# declared files in the compile sandbox); hdrs alone add no include
# root, so nothing is shadowed.
cc_library(
    name = "clocksource_headers",
    hdrs = glob([
        "**/*.h",
        "**/*.hh",
        "**/*.hpp",
        "**/*.hxx",
        "**/*.inc",
        "**/*.inl",
        "**/*.ipp",
    ], allow_empty = True),
)

# the object(s) of `drivers_clocksource_built_in` a recipe reads, at the paths it names
cc_object_files(
    name = "drivers_clocksource_built_in_objects",
    lib = ":drivers_clocksource_built_in",
    objects = ["i8253.o"],
)

# the library, its archive (the reference's own ar recipe: members
# in its order, which is the link order) and the objects a recipe
# reads by path: the macro owns the archive
kernel_library(
    name = "drivers_clocksource_built_in",
    srcs = ["i8253.c"],
    copts = [
        "-Idrivers/clocksource",
        "-DKBUILD_MODFILE=\\\"drivers/clocksource/i8253\\\"",
        "-DKBUILD_BASENAME=\\\"i8253\\\"",
        "-DKBUILD_MODNAME=\\\"i8253\\\"",
        "-D__KBUILD_MODNAME=i8253",
        "-I$(GENDIR)",
    ],
    deps = [
        ":clocksource_headers",
        "//:pkg_headers",
        "//:pkg_generated_under_arch_x86__include_generated_2",
        "//drivers:drivers_headers",
    ],
    features = ["kernel_compile_flags"],
    out = "built-in.a",
    op = "cDPrST",
    members = ["i8253.o"],
    ar = "@kernel_llvm//:bin/llvm-ar",
)
