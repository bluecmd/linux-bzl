# fs/proc: BUILD.bazel emitted by any2bazel emit_build.py from the reference model.
#
# Derived mechanically from model.capture.json (re-run the emitter
# rather than editing the derived parts by hand; the differ is the oracle):
#   fs_proc_built-in (static_library) -> cc_library fs_proc_built_in
#
# Notes:
#   - `fs_proc_built-in`: the reference built fs/proc/built-in.a with its own ar recipe; it is a
#     genrule over the captured argv (the member order is the link order), not an aggregate
#     merged in Bazel's order
#   - `fs_proc_built_in`: 2 flag groups differing by at most 8 tokens -> one
#     cc_per_source_library with a per-source map
#   - `fs_proc_built_in`: TUs whose argvs differ only in Kbuild's per-object defines -> one
#     cc_per_source_library; the defines ride the per-source map (the rule computes what its
#     arithmetic can)
#   - fs_proc_built_in_a: the ar recipe runs as an ar_archive rule (26 member(s))
load("//bazel/rules:cc_object_files.bzl", "cc_object_files")
load("//bazel/rules:kernel_library.bzl", "kernel_library")
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])
exports_files([
    "Kconfig",
])


# Every header of this package its TUs can reach (Bazel only puts
# declared files in the compile sandbox); hdrs alone add no include
# root, so nothing is shadowed.
cc_library(
    name = "proc_headers",
    hdrs = glob([
        "**/*.h",
        "**/*.hh",
        "**/*.hpp",
        "**/*.hxx",
        "**/*.inc",
        "**/*.inl",
        "**/*.ipp",
    ], allow_empty = True),
)

# the object(s) of `fs_proc_built_in` a recipe reads, at the paths it names
cc_object_files(
    name = "fs_proc_built_in_objects",
    lib = ":fs_proc_built_in",
    objects = [
        "array.o",
        "base.o",
        "cmdline.o",
        "consoles.o",
        "cpuinfo.o",
        "devices.o",
        "fd.o",
        "generic.o",
