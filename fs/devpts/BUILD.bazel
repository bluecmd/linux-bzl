# fs/devpts: BUILD.bazel emitted by any2bazel emit_build.py from the reference model.
#
# Derived mechanically from model.capture.json (re-run the emitter
# rather than editing the derived parts by hand; the differ is the oracle):
#   fs_devpts_built-in (static_library) -> cc_library fs_devpts_built_in
#
# Notes:
#   - `fs_devpts_built-in`: the reference built fs/devpts/built-in.a with its own ar recipe; it
#     is a genrule over the captured argv (the member order is the link order), not an aggregate
#     merged in Bazel's order
#   - fs_devpts_built_in_a: the ar recipe runs as an ar_archive rule (1 member(s))
load("//bazel/rules:cc_object_files.bzl", "cc_object_files")
load("//bazel/rules:kernel_library.bzl", "kernel_library")
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# Every header of this package its TUs can reach (Bazel only puts
# declared files in the compile sandbox); hdrs alone add no include
# root, so nothing is shadowed.
cc_library(
    name = "devpts_headers",
    hdrs = glob([
        "**/*.h",
        "**/*.hh",
        "**/*.hpp",
        "**/*.hxx",
        "**/*.inc",
        "**/*.inl",
        "**/*.ipp",
    ], allow_empty = True),
)

# the object(s) of `fs_devpts_built_in` a recipe reads, at the paths it names
cc_object_files(
    name = "fs_devpts_built_in_objects",
    lib = ":fs_devpts_built_in",
    objects = ["inode.o"],
)

# the library, its archive (the reference's own ar recipe: members
# in its order, which is the link order) and the objects a recipe
# reads by path: the macro owns the archive
kernel_library(
    name = "fs_devpts_built_in",
    srcs = ["inode.c"],
    copts = [
        "-Ifs/devpts",
        "-DKBUILD_MODFILE=\\\"fs/devpts/devpts\\\"",
        "-DKBUILD_BASENAME=\\\"inode\\\"",
        "-DKBUILD_MODNAME=\\\"devpts\\\"",
        "-D__KBUILD_MODNAME=devpts",
        "-I$(GENDIR)",
    ],
    deps = [
        ":devpts_headers",
        "//:pkg_headers",
        "//:pkg_generated_under_arch_x86__include_generated_2",
        "//fs:fs_headers",
    ],
    features = ["kernel_compile_flags"],
    out = "built-in.a",
    op = "cDPrST",
    members = ["inode.o"],
    ar = "@kernel_llvm//:bin/llvm-ar",
)
