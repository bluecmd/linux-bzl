#   fs_iomap_built-in (static_library) -> cc_library fs_iomap_built_in
load("//bazel/rules:cc_object_files.bzl", "cc_object_files")
load("//bazel/rules:kernel_library.bzl", "kernel_library")
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# Every header of this package its TUs can reach (Bazel only puts
# declared files in the compile sandbox); hdrs alone add no include
# root, so nothing is shadowed.
cc_library(
    name = "iomap_headers",
    hdrs = glob([
        "**/*.h",
        "**/*.hh",
        "**/*.hpp",
        "**/*.hxx",
        "**/*.inc",
        "**/*.inl",
        "**/*.ipp",
    ], allow_empty = True),
)

# the object(s) of `fs_iomap_built_in` a recipe reads, at the paths it names
cc_object_files(
    name = "fs_iomap_built_in_objects",
    lib = ":fs_iomap_built_in",
    objects = [
        "bio.o",
        "buffered-io.o",
        "direct-io.o",
        "fiemap.o",
        "ioend.o",
        "iter.o",
        "seek.o",
        "swapfile.o",
        "trace.o",
    ],
)

# the library, its archive (the reference's own ar recipe: members
# in its order, which is the link order) and the objects a recipe
# reads by path: the macro owns the archive
kernel_library(
    name = "fs_iomap_built_in",
    srcs = [
        "bio.c",
        "buffered-io.c",
        "direct-io.c",
        "fiemap.c",
        "ioend.c",
        "iter.c",
        "seek.c",
        "swapfile.c",
        "trace.c",
    ],
    copts = [
        "-Ifs/iomap",
        "-DKBUILD_MODFILE=\\\"fs/iomap/iomap\\\"",
        "-DKBUILD_MODNAME=\\\"iomap\\\"",
        "-D__KBUILD_MODNAME=iomap",
        "-I$(GENDIR)",
    ],
    deps = [
        ":iomap_headers",
        "//:pkg_headers",
        "//:pkg_generated_under_arch_x86__include_generated_2",
        "//fs:fs_headers",
    ],
    features = ["kernel_compile_flags"],
    kbuild = "module",
    out = "built-in.a",
    op = "cDPrST",
    members = [
        "trace.o",
        "iter.o",
        "buffered-io.o",
        "direct-io.o",
        "ioend.o",
        "fiemap.o",
        "seek.o",
        "bio.o",
        "swapfile.o",
    ],
    ar = "@kernel_llvm//:bin/llvm-ar",
