# lib/crc: BUILD.bazel emitted by any2bazel emit_build.py from the reference model.
#
# Derived mechanically from model.capture.json (re-run the emitter
# rather than editing the derived parts by hand; the differ is the oracle):
#   lib_crc_built-in (static_library) -> cc_library lib_crc_built_in
load("//bazel/rules:cc_object_files.bzl", "cc_object_files")
load("//bazel/rules:kernel_library.bzl", "kernel_library")
load("//bazel/rules:tool_stdout.bzl", "tool_stdout")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")

package(default_visibility = ["//visibility:public"])
exports_files([
    "Kconfig",
])


# Every header of this package its TUs can reach (Bazel only puts
# declared files in the compile sandbox); hdrs alone add no include
# root, so nothing is shadowed.
cc_library(
    name = "crc_headers",
    hdrs = glob([
        "**/*.h",
        "**/*.hh",
        "**/*.hpp",
        "**/*.hxx",
        "**/*.inc",
        "**/*.inl",
        "**/*.ipp",
    ], allow_empty = True),
)

# host tool the reference builds with `clang` (host tool run by gen_crc32table); listed
# under a genrule's `tools`, Bazel builds it for the exec platform
cc_binary(
    name = "gen_crc32table",
    srcs = [
        "gen_crc32table.c",
        "//:include/generated/autoconf.h",
    ],
    copts = [
        "-Wstrict-prototypes",
        "-O2",
        "-Iscripts/include",
        "-Ilib/crc",
        "-I$(GENDIR)/lib/crc",
        "-fuse-ld=lld",
        "-iquote$(GENDIR)/include/generated",
    ],
    deps = [
        ":crc_headers",
        "//:pkg_headers",
        "//lib:lib_headers",
        "//scripts:scripts_headers",
    ],
    tags = ["manual"],
)

# the object(s) of `lib_crc_built_in` a recipe reads, at the paths it names
cc_object_files(
    name = "lib_crc_built_in_objects",
    lib = ":lib_crc_built_in",
    objects = [
        "crc16.o",
        "crc32-main.o",
    ],
)

# gen_crc32table @ None: lib/crc/crc32table.h
# the one-off generator step: the tool's output the file it names
tool_stdout(
    name = "crc32table_h",
    tool = ":gen_crc32table",
    out = "crc32table.h",
    cmd = "$(location :gen_crc32table) > $@",
)

# the library, its archive (the reference's own ar recipe: members
# in its order, which is the link order) and the objects a recipe
# reads by path: the macro owns the archive
kernel_library(
    name = "lib_crc_built_in",
    srcs = [
        "crc16.c",
        "crc32-main.c",
    ],
    copts = [
        "-Ilib/crc",
        "-I$(GENDIR)/lib/crc",
        "-iquote$(GENDIR)/lib/crc",
    ],
    deps = [
        ":crc_headers",
        "//:pkg_headers",
        "//:pkg_generated_under_arch_x86__include_generated__lib_crc",
        "//lib:lib_headers",
    ],
    features = ["kernel_compile_flags"],
    kbuild = "built-in",
    kbuild_modules = {
        "crc32": ["crc32-main.c"],
    },
    out = "built-in.a",
    op = "cDPrST",
    members = [
        "crc16.o",
        "crc32-main.o",
    ],
    ar = "@kernel_llvm//:bin/llvm-ar",
)
