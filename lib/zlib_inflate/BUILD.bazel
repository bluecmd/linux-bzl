#   - lib_zlib_inflate_built_in_a: the ar recipe runs as an ar_archive rule (5 member(s))
load("//bazel/rules:cc_object_files.bzl", "cc_object_files")
load("//bazel/rules:kernel_library.bzl", "kernel_library")
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# Every header of this package its TUs can reach (Bazel only puts
# declared files in the compile sandbox); hdrs alone add no include
# root, so nothing is shadowed.
cc_library(
    name = "zlib_inflate_headers",
    hdrs = glob([
        "**/*.h",
        "**/*.hh",
        "**/*.hpp",
        "**/*.hxx",
        "**/*.inc",
        "**/*.inl",
        "**/*.ipp",
    ], exclude = [
        "inffast.c",
        "inflate.c",
        "inftrees.c",
    ], allow_empty = True),
    textual_hdrs = [
        "inffast.c",
        "inflate.c",
        "inftrees.c",
    ],
)

# the object(s) of `lib_zlib_inflate_built_in` a recipe reads, at the paths it names
cc_object_files(
    name = "lib_zlib_inflate_built_in_objects",
    lib = ":lib_zlib_inflate_built_in",
    objects = [
        "inffast.o",
        "inflate.o",
        "inflate_syms.o",
        "inftrees.o",
        "infutil.o",
    ],
)

# the library, its archive (the reference's own ar recipe: members
# in its order, which is the link order) and the objects a recipe
# reads by path: the macro owns the archive
kernel_library(
    name = "lib_zlib_inflate_built_in",
    srcs = [
        "inffast.c",
        "inflate.c",
        "inflate_syms.c",
        "inftrees.c",
        "infutil.c",
    ],
    copts = [
        "-Ilib/zlib_inflate",
        "-I$(GENDIR)",
    ],
    deps = [
        ":zlib_inflate_headers",
        "//:pkg_headers",
        "//:pkg_generated_under_arch_x86__include_generated_2",
        "//lib:lib_headers",
    ],
    features = ["kernel_compile_flags"],
    kbuild = "zlib_inflate",
    out = "built-in.a",
    op = "cDPrST",
    members = [
        "inffast.o",
        "inflate.o",
        "infutil.o",
        "inftrees.o",
        "inflate_syms.o",
    ],
    ar = "@kernel_llvm//:bin/llvm-ar",
)
