# lib/math: BUILD.bazel emitted by any2bazel emit_build.py from the reference model.
#
# Derived mechanically from model.capture.json (re-run the emitter
# rather than editing the derived parts by hand; the differ is the oracle):
#   lib_math_built-in (static_library) -> cc_library lib_math_built_in
#
# Notes:
#   - `lib_math_built-in`: the reference built lib/math/built-in.a with its own ar recipe; it is
#     a genrule over the captured argv (the member order is the link order), not an aggregate
#     merged in Bazel's order
#   - `lib_math_built-in`: the ar recipe drops `lib/math/tests/built-in.a` (its archive
#     `lib_math_tests_built-in` is not emitted); the reference's content for it is outside the
#     emitted scope
#   - `lib_math_built_in`: TUs whose argvs differ only in Kbuild's per-object defines -> one
#     cc_per_source_library; the defines ride the per-source map (the rule computes what its
#     arithmetic can)
#   - lib_math_built_in_a: the ar recipe runs as an ar_archive rule (8 member(s))
load("//bazel/rules:cc_object_files.bzl", "cc_object_files")
load("//bazel/rules:kernel_library.bzl", "kernel_library")
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])
exports_files([
    "Kconfig",
])


# Every header of this package its TUs can reach (Bazel only puts
# declared files in the compile sandbox); hdrs alone add no include
# root, so nothing is shadowed.
cc_library(
    name = "math_headers",
    hdrs = glob([
        "**/*.h",
        "**/*.hh",
        "**/*.hpp",
        "**/*.hxx",
        "**/*.inc",
        "**/*.inl",
        "**/*.ipp",
    ], allow_empty = True),
)

# the object(s) of `lib_math_built_in` a recipe reads, at the paths it names
cc_object_files(
    name = "lib_math_built_in_objects",
    lib = ":lib_math_built_in",
    objects = [
        "div64.o",
        "gcd.o",
        "int_log.o",
        "int_pow.o",
        "int_sqrt.o",
        "lcm.o",
        "rational.o",
        "reciprocal_div.o",
    ],
)

# the library, its archive (the reference's own ar recipe: members
# in its order, which is the link order) and the objects a recipe
# reads by path: the macro owns the archive
kernel_library(
    name = "lib_math_built_in",
    srcs = [
        "div64.c",
        "gcd.c",
        "int_log.c",
        "int_pow.c",
        "int_sqrt.c",
        "lcm.c",
        "rational.c",
        "reciprocal_div.c",
    ],
    copts = [
        "-Ilib/math",
        "-I$(GENDIR)",
    ],
    deps = [
        ":math_headers",
        "//:pkg_headers",
        "//:pkg_generated_under_arch_x86__include_generated_2",
        "//lib:lib_headers",
    ],
    features = ["kernel_compile_flags"],
    kbuild = "built-in",
    out = "built-in.a",
    op = "cDPrST",
    members = [
        "div64.o",
        "gcd.o",
        "lcm.o",
        "int_log.o",
        "int_pow.o",
        "int_sqrt.o",
        "reciprocal_div.o",
        "rational.o",
    ],
    ar = "@kernel_llvm//:bin/llvm-ar",
)
