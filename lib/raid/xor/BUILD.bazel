# lib/raid/xor: BUILD.bazel emitted by any2bazel emit_build.py from the reference model.
#
# Derived mechanically from model.capture.json (re-run the emitter
# rather than editing the derived parts by hand; the differ is the oracle):
#
# Notes:
#   - `lib_raid_xor_built-in`: the reference built lib/raid/xor/built-in.a with its own ar
#     recipe; it is a genrule over the captured argv (the member order is the link order), not
#     an aggregate merged in Bazel's order
#   - `lib_raid_xor_built-in`: the ar recipe drops `lib/raid/xor/tests/built-in.a` (its archive
#     `lib_raid_xor_tests_built-in` is not emitted); the reference's content for it is outside
#     the emitted scope
load("//bazel/rules:ar_archive.bzl", "ar_archive")
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# Every header of this package its TUs can reach (Bazel only puts
# declared files in the compile sandbox); hdrs alone add no include
# root, so nothing is shadowed.
cc_library(
    name = "xor_headers",
    hdrs = glob([
        "**/*.h",
        "**/*.hh",
        "**/*.hpp",
        "**/*.hxx",
        "**/*.inc",
        "**/*.inl",
        "**/*.ipp",
    ], allow_empty = True),
)

# the reference's own ar recipe: members in its order, which is
# the link order (an aggregate's merge order is Bazel's, not the
# reference's)
ar_archive(
    name = "lib_raid_xor_built_in_a",
    out = "built-in.a",
    op = "cDPrST",
    ar = "@kernel_llvm//:bin/llvm-ar",
)
