# net/9p: BUILD.bazel emitted by any2bazel emit_build.py from the reference model.
#
# Derived mechanically from model.capture.json (re-run the emitter
# rather than editing the derived parts by hand; the differ is the oracle):
#   net_9p_built-in (static_library) -> cc_library net_9p_built_in
#
# Notes:
#   - `net_9p_built-in`: the reference built net/9p/built-in.a with its own ar recipe; it is a
#     genrule over the captured argv (the member order is the link order), not an aggregate
#     merged in Bazel's order
#   - `net_9p_built_in`: TUs whose argvs differ only in Kbuild's per-object defines -> one
#     cc_per_source_library; the defines ride the per-source map (the rule computes what its
#     arithmetic can)
#   - net_9p_built_in_a: the ar recipe runs as an ar_archive rule (7 member(s))
load("//bazel/rules:cc_object_files.bzl", "cc_object_files")
load("//bazel/rules:kernel_library.bzl", "kernel_library")
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])
exports_files([
    "Kconfig",
])


# Every header of this package its TUs can reach (Bazel only puts
# declared files in the compile sandbox); hdrs alone add no include
# root, so nothing is shadowed.
cc_library(
    name = "9p_headers",
    hdrs = glob([
        "**/*.h",
        "**/*.hh",
        "**/*.hpp",
        "**/*.hxx",
        "**/*.inc",
        "**/*.inl",
        "**/*.ipp",
    ], allow_empty = True),
)

# the object(s) of `net_9p_built_in` a recipe reads, at the paths it names
cc_object_files(
    name = "net_9p_built_in_objects",
    lib = ":net_9p_built_in",
    objects = [
        "client.o",
        "error.o",
        "mod.o",
        "protocol.o",
        "trans_common.o",
        "trans_fd.o",
        "trans_virtio.o",
    ],
)

# the library, its archive (the reference's own ar recipe: members
# in its order, which is the link order) and the objects a recipe
# reads by path: the macro owns the archive
kernel_library(
    name = "net_9p_built_in",
    srcs = [
        "client.c",
        "error.c",
        "mod.c",
        "protocol.c",
        "trans_common.c",
        "trans_fd.c",
        "trans_virtio.c",
    ],
    copts = [
        "-Inet/9p",
        "-I$(GENDIR)",
    ],
    deps = [
        ":9p_headers",
        "//:pkg_headers",
        "//:pkg_generated_under_arch_x86__include_generated_2",
        "//net:net_headers",
    ],
    features = ["kernel_compile_flags"],
    kbuild = "built-in",
    kbuild_modules = {
        "9pnet": [
            "client.c",
            "error.c",
            "mod.c",
            "protocol.c",
            "trans_common.c",
        ],
        "9pnet_fd": ["trans_fd.c"],
        "9pnet_virtio": ["trans_virtio.c"],
    },
    out = "built-in.a",
    op = "cDPrST",
    members = [
        "mod.o",
        "client.o",
        "error.o",
        "protocol.o",
        "trans_common.o",
        "trans_fd.o",
        "trans_virtio.o",
    ],
    ar = "@kernel_llvm//:bin/llvm-ar",
)
