# net/ethernet: BUILD.bazel emitted by any2bazel emit_build.py from the reference model.
#
# Derived mechanically from model.capture.json (re-run the emitter
# rather than editing the derived parts by hand; the differ is the oracle):
#   net_ethernet_built-in (static_library) -> cc_library net_ethernet_built_in
#
# Notes:
#   - `net_ethernet_built-in`: the reference built net/ethernet/built-in.a with its own ar
#     recipe; it is a genrule over the captured argv (the member order is the link order), not
#     an aggregate merged in Bazel's order
#   - net_ethernet_built_in_a: the ar recipe runs as an ar_archive rule (1 member(s))
load("//bazel/rules:cc_object_files.bzl", "cc_object_files")
load("//bazel/rules:kernel_library.bzl", "kernel_library")
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# Every header of this package its TUs can reach (Bazel only puts
# declared files in the compile sandbox); hdrs alone add no include
# root, so nothing is shadowed.
cc_library(
    name = "ethernet_headers",
    hdrs = glob([
        "**/*.h",
        "**/*.hh",
        "**/*.hpp",
        "**/*.hxx",
        "**/*.inc",
        "**/*.inl",
        "**/*.ipp",
    ], allow_empty = True),
)

# the object(s) of `net_ethernet_built_in` a recipe reads, at the paths it names
cc_object_files(
    name = "net_ethernet_built_in_objects",
    lib = ":net_ethernet_built_in",
    objects = ["eth.o"],
)

# the library, its archive (the reference's own ar recipe: members
# in its order, which is the link order) and the objects a recipe
# reads by path: the macro owns the archive
kernel_library(
    name = "net_ethernet_built_in",
    srcs = ["eth.c"],
    copts = [
        "-Inet/ethernet",
        "-DKBUILD_MODFILE=\\\"net/ethernet/eth\\\"",
        "-DKBUILD_BASENAME=\\\"eth\\\"",
        "-DKBUILD_MODNAME=\\\"eth\\\"",
        "-D__KBUILD_MODNAME=eth",
        "-I$(GENDIR)",
    ],
    deps = [
        ":ethernet_headers",
        "//:pkg_headers",
        "//:pkg_generated_under_arch_x86__include_generated_2",
        "//net:net_headers",
    ],
    features = ["kernel_compile_flags"],
    out = "built-in.a",
    op = "cDPrST",
    members = ["eth.o"],
    ar = "@kernel_llvm//:bin/llvm-ar",
)
