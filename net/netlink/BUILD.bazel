# net/netlink: BUILD.bazel emitted by any2bazel emit_build.py from the reference model.
#
# Derived mechanically from model.capture.json (re-run the emitter
# rather than editing the derived parts by hand; the differ is the oracle):
#   net_netlink_built-in (static_library) -> cc_library net_netlink_built_in
load("//bazel/rules:cc_object_files.bzl", "cc_object_files")
load("//bazel/rules:kernel_library.bzl", "kernel_library")
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])
exports_files([
    "Kconfig",
])


# Every header of this package its TUs can reach (Bazel only puts
# declared files in the compile sandbox); hdrs alone add no include
# root, so nothing is shadowed.
cc_library(
    name = "netlink_headers",
    hdrs = glob([
        "**/*.h",
        "**/*.hh",
        "**/*.hpp",
        "**/*.hxx",
        "**/*.inc",
        "**/*.inl",
        "**/*.ipp",
    ], allow_empty = True),
)

# the object(s) of `net_netlink_built_in` a recipe reads, at the paths it names
cc_object_files(
    name = "net_netlink_built_in_objects",
    lib = ":net_netlink_built_in",
    objects = [
        "af_netlink.o",
        "genetlink.o",
        "policy.o",
    ],
)

# the library, its archive (the reference's own ar recipe: members
# in its order, which is the link order) and the objects a recipe
# reads by path: the macro owns the archive
kernel_library(
    name = "net_netlink_built_in",
    srcs = [
        "af_netlink.c",
        "genetlink.c",
        "policy.c",
    ],
    copts = [
        "-Inet/netlink",
        "-I$(GENDIR)",
    ],
    deps = [
        ":netlink_headers",
        "//:pkg_headers",
        "//:pkg_generated_under_arch_x86__include_generated_2",
        "//net:net_headers",
    ],
    features = ["kernel_compile_flags"],
    kbuild = "built-in",
    out = "built-in.a",
    op = "cDPrST",
    members = [
        "af_netlink.o",
        "genetlink.o",
        "policy.o",
    ],
    ar = "@kernel_llvm//:bin/llvm-ar",
)
