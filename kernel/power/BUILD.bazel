# kernel/power: BUILD.bazel emitted by any2bazel emit_build.py from the reference model.
#
# Derived mechanically from model.capture.json (re-run the emitter
# rather than editing the derived parts by hand; the differ is the oracle):
#   kernel_power_built-in (static_library) -> cc_library kernel_power_built_in
load("//bazel/rules:ar_archive.bzl", "ar_archive")
load("//bazel/rules:cc_object_files.bzl", "cc_object_files")
load("//bazel/rules:cc_per_source_library.bzl", "cc_per_source_library")
load("//bazel/rules:cc_raw_link.bzl", "cc_raw_link")
load("//bazel/rules:tree_recipe.bzl", "tree_recipe")
load("@rules_cc//cc:cc_static_library.bzl", "cc_static_library")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")

package(default_visibility = ["//visibility:public"])
exports_files([
    "Kconfig",
])


# Every header of this package its TUs can reach (Bazel only puts
# declared files in the compile sandbox); hdrs alone add no include
# root, so nothing is shadowed.
cc_library(
    name = "power_headers",
    hdrs = glob([
        "**/*.h",
        "**/*.hh",
        "**/*.hpp",
        "**/*.hxx",
        "**/*.inc",
        "**/*.inl",
        "**/*.ipp",
    ], allow_empty = True),
)

# the object(s) of `kernel_power_built_in` a recipe reads, at the paths it names
cc_object_files(
    name = "kernel_power_built_in_objects",
    lib = ":kernel_power_built_in",
    objects = ["qos.o"],
)

# the reference's own ar recipe: members in its order, which is
# the link order (an aggregate's merge order is Bazel's, not the
# reference's)
ar_archive(
    name = "kernel_power_built_in_a",
    out = "built-in.a",
    op = "cDPrST",
    members = ["qos.o"],
    srcs = ["qos.o"],
    ar = "@kernel_llvm//:bin/llvm-ar",
)

# CMake `kernel_power_built-in` (static library)
cc_library(
    name = "kernel_power_built_in",
    srcs = ["qos.c"],
    copts = [
        "-Ikernel/power",
        "-DKBUILD_MODFILE=\\\"kernel/power/qos\\\"",
        "-DKBUILD_BASENAME=\\\"qos\\\"",
        "-DKBUILD_MODNAME=\\\"qos\\\"",
        "-D__KBUILD_MODNAME=qos",
        "-I$(GENDIR)",
    ],
    deps = [
        ":power_headers",
        "//:pkg_headers",
        "//:pkg_generated_under_arch_x86__include_generated_2",
        "//kernel:kernel_headers",
    ],
    features = ["kernel_compile_flags"],
)
