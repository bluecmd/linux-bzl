# kernel/events: BUILD.bazel emitted by any2bazel emit_build.py from the reference model.
#
# Derived mechanically from model.capture.json (re-run the emitter
# rather than editing the derived parts by hand; the differ is the oracle):
#   kernel_events_built-in (static_library) -> cc_library kernel_events_built_in
#
# Notes:
#   - `kernel_events_built-in`: the reference built kernel/events/built-in.a with its own ar
#     recipe; it is a genrule over the captured argv (the member order is the link order), not
#     an aggregate merged in Bazel's order
#   - `kernel_events_built_in`: TUs whose argvs differ only in Kbuild's per-object defines ->
#     one cc_per_source_library; the defines ride the per-source map (the rule computes what its
#     arithmetic can)
#   - kernel_events_built_in_a: the ar recipe runs as an ar_archive rule (4 member(s))
load("//bazel/rules:cc_object_files.bzl", "cc_object_files")
load("//bazel/rules:kernel_library.bzl", "kernel_library")
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# Every header of this package its TUs can reach (Bazel only puts
# declared files in the compile sandbox); hdrs alone add no include
# root, so nothing is shadowed.
cc_library(
    name = "events_headers",
    hdrs = glob([
        "**/*.h",
        "**/*.hh",
        "**/*.hpp",
        "**/*.hxx",
        "**/*.inc",
        "**/*.inl",
        "**/*.ipp",
    ], allow_empty = True),
)

# the object(s) of `kernel_events_built_in` a recipe reads, at the paths it names
cc_object_files(
    name = "kernel_events_built_in_objects",
    lib = ":kernel_events_built_in",
    objects = [
        "callchain.o",
        "core.o",
        "hw_breakpoint.o",
        "ring_buffer.o",
    ],
)

# the library, its archive (the reference's own ar recipe: members
# in its order, which is the link order) and the objects a recipe
# reads by path: the macro owns the archive
kernel_library(
    name = "kernel_events_built_in",
    srcs = [
        "callchain.c",
        "core.c",
        "hw_breakpoint.c",
        "ring_buffer.c",
    ],
    copts = [
        "-Ikernel/events",
        "-I$(GENDIR)",
    ],
    deps = [
        ":events_headers",
        "//:pkg_headers",
        "//:pkg_generated_under_arch_x86__include_generated_2",
        "//kernel:kernel_headers",
    ],
    features = ["kernel_compile_flags"],
    kbuild = "built-in",
    out = "built-in.a",
    op = "cDPrST",
    members = [
        "core.o",
        "ring_buffer.o",
        "callchain.o",
        "hw_breakpoint.o",
    ],
    ar = "@kernel_llvm//:bin/llvm-ar",
)
