# kernel/rcu: BUILD.bazel emitted by any2bazel emit_build.py from the reference model.
#
# Derived mechanically from model.capture.json (re-run the emitter
# rather than editing the derived parts by hand; the differ is the oracle):
#   kernel_rcu_built-in (static_library) -> cc_library kernel_rcu_built_in
#
# Notes:
#   - `kernel_rcu_built-in`: the reference built kernel/rcu/built-in.a with its own ar recipe;
#     it is a genrule over the captured argv (the member order is the link order), not an
#     aggregate merged in Bazel's order
#   - `kernel_rcu_built_in`: TUs whose argvs differ only in Kbuild's per-object defines -> one
#     cc_per_source_library; the defines ride the per-source map (the rule computes what its
#     arithmetic can)
#   - kernel_rcu_built_in_a: the ar recipe runs as an ar_archive rule (5 member(s))
load("//bazel/rules:cc_object_files.bzl", "cc_object_files")
load("//bazel/rules:kernel_library.bzl", "kernel_library")
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])
exports_files([
    "Kconfig",
    "Kconfig.debug",
])


# Every header of this package its TUs can reach (Bazel only puts
# declared files in the compile sandbox); hdrs alone add no include
# root, so nothing is shadowed.
cc_library(
    name = "rcu_headers",
    hdrs = glob([
        "**/*.h",
        "**/*.hh",
        "**/*.hpp",
        "**/*.hxx",
        "**/*.inc",
        "**/*.inl",
        "**/*.ipp",
    ], allow_empty = True),
)

# the object(s) of `kernel_rcu_built_in` a recipe reads, at the paths it names
cc_object_files(
    name = "kernel_rcu_built_in_objects",
    lib = ":kernel_rcu_built_in",
    objects = [
        "rcu_segcblist.o",
        "srcutree.o",
        "sync.o",
        "tree.o",
        "update.o",
    ],
)

# the library, its archive (the reference's own ar recipe: members
# in its order, which is the link order) and the objects a recipe
# reads by path: the macro owns the archive
kernel_library(
    name = "kernel_rcu_built_in",
    srcs = [
        "rcu_segcblist.c",
        "srcutree.c",
        "sync.c",
        "tree.c",
        "update.c",
    ],
    copts = [
        "-Ikernel/rcu",
        "-I$(GENDIR)",
    ],
    deps = [
        ":rcu_headers",
        "//:pkg_headers",
        "//:pkg_generated_under_arch_x86__include_generated_2",
        "//kernel:kernel_headers",
    ],
    features = ["kernel_compile_flags"],
    kbuild = "built-in",
    out = "built-in.a",
    op = "cDPrST",
    members = [
        "update.o",
        "sync.o",
        "srcutree.o",
        "tree.o",
        "rcu_segcblist.o",
    ],
    ar = "@kernel_llvm//:bin/llvm-ar",
)
