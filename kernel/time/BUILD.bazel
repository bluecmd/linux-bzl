# kernel/time: BUILD.bazel emitted by any2bazel emit_build.py from the reference model.
#
# Derived mechanically from model.capture.json (re-run the emitter
# rather than editing the derived parts by hand; the differ is the oracle):
#   kernel_time_built-in (static_library) -> cc_library kernel_time_built_in
load("//bazel/rules:cc_object_files.bzl", "cc_object_files")
load("//bazel/rules:kernel_library.bzl", "kernel_library")
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])
exports_files([
    "Kconfig",
    "timeconst.bc",
])


# Every header of this package its TUs can reach (Bazel only puts
# declared files in the compile sandbox); hdrs alone add no include
# root, so nothing is shadowed.
cc_library(
    name = "time_headers",
    hdrs = glob([
        "**/*.h",
        "**/*.hh",
        "**/*.hpp",
        "**/*.hxx",
        "**/*.inc",
        "**/*.inl",
        "**/*.ipp",
    ], allow_empty = True),
)

# the object(s) of `kernel_time_built_in` a recipe reads, at the paths it names
cc_object_files(
    name = "kernel_time_built_in_objects",
    lib = ":kernel_time_built_in",
    objects = [
        "alarmtimer.o",
        "clockevents.o",
        "clocksource.o",
        "hrtimer.o",
        "jiffies.o",
        "ntp.o",
        "posix-stubs.o",
        "sleep_timeout.o",
        "tick-broadcast.o",
        "tick-common.o",
        "time.o",
        "timeconv.o",
        "timecounter.o",
        "timekeeping.o",
        "timer.o",
        "timer_list.o",
        "vsyscall.o",
    ],
)

# the library, its archive (the reference's own ar recipe: members
# in its order, which is the link order) and the objects a recipe
# reads by path: the macro owns the archive
kernel_library(
    name = "kernel_time_built_in",
    srcs = [
        "alarmtimer.c",
        "clockevents.c",
        "clocksource.c",
        "hrtimer.c",
        "jiffies.c",
        "ntp.c",
        "posix-stubs.c",
        "sleep_timeout.c",
        "tick-broadcast.c",
        "tick-common.c",
        "time.c",
        "timeconv.c",
        "timecounter.c",
        "timekeeping.c",
        "timer.c",
        "timer_list.c",
        "vsyscall.c",
    ],
    copts = [
        "-Ikernel/time",
        "-I$(GENDIR)",
    ],
    deps = [
        ":time_headers",
        "//:pkg_headers",
        "//:pkg_generated_under_arch_x86__include_generated_2",
        "//kernel:kernel_headers",
    ],
    features = ["kernel_compile_flags"],
    kbuild = "built-in",
    out = "built-in.a",
    op = "cDPrST",
    members = [
        "time.o",
        "timer.o",
        "hrtimer.o",
        "sleep_timeout.o",
        "timekeeping.o",
        "ntp.o",
        "clocksource.o",
