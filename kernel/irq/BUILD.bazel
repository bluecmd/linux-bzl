    ],
    copts = [
        "-Ikernel/irq",
        "-I$(GENDIR)",
    ],
    deps = [
        ":irq_headers",
        "//:pkg_headers",
        "//:pkg_generated_under_arch_x86__include_generated_2",
        "//kernel:kernel_headers",
    ],
    features = ["kernel_compile_flags"],
    kbuild = "built-in",
    out = "built-in.a",
    op = "cDPrST",
    members = [
        "irqdesc.o",
        "handle.o",
