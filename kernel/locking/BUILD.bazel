# kernel/locking: BUILD.bazel emitted by any2bazel emit_build.py from the reference model.
#
# Derived mechanically from model.capture.json (re-run the emitter
# rather than editing the derived parts by hand; the differ is the oracle):
#   kernel_locking_built-in (static_library) -> cc_library kernel_locking_built_in
load("//bazel/rules:ar_archive.bzl", "ar_archive")
load("//bazel/rules:cc_object_files.bzl", "cc_object_files")
load("//bazel/rules:cc_per_source_library.bzl", "cc_per_source_library")
load("//bazel/rules:cc_raw_link.bzl", "cc_raw_link")
load("//bazel/rules:tree_recipe.bzl", "tree_recipe")
load("@rules_cc//cc:cc_static_library.bzl", "cc_static_library")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")

package(default_visibility = ["//visibility:public"])

# Every header of this package its TUs can reach (Bazel only puts
# declared files in the compile sandbox); hdrs alone add no include
# root, so nothing is shadowed.
cc_library(
    name = "locking_headers",
    hdrs = glob([
        "**/*.h",
        "**/*.hh",
        "**/*.hpp",
        "**/*.hxx",
        "**/*.inc",
        "**/*.inl",
        "**/*.ipp",
    ], exclude = [
        "rtmutex.c",
        "rwbase_rt.c",
    ], allow_empty = True),
    textual_hdrs = [
        "rtmutex.c",
        "rwbase_rt.c",
    ],
)

# the object(s) of `kernel_locking_built_in` a recipe reads, at the paths it names
cc_object_files(
    name = "kernel_locking_built_in_objects",
    lib = ":kernel_locking_built_in",
    objects = [
        "mutex.o",
        "osq_lock.o",
        "percpu-rwsem.o",
        "qrwlock.o",
        "qspinlock.o",
        "rtmutex_api.o",
        "rwsem.o",
        "semaphore.o",
        "spinlock.o",
    ],
)

# the reference's own ar recipe: members in its order, which is
# the link order (an aggregate's merge order is Bazel's, not the
# reference's)
ar_archive(
    name = "kernel_locking_built_in_a",
    out = "built-in.a",
    op = "cDPrST",
    members = [
        "mutex.o",
        "semaphore.o",
        "rwsem.o",
        "percpu-rwsem.o",
        "spinlock.o",
        "osq_lock.o",
        "qspinlock.o",
        "rtmutex_api.o",
        "qrwlock.o",
    ],
    srcs = [
        "mutex.o",
        "semaphore.o",
        "rwsem.o",
        "percpu-rwsem.o",
        "spinlock.o",
        "osq_lock.o",
        "qspinlock.o",
        "rtmutex_api.o",
        "qrwlock.o",
    ],
    ar = "@kernel_llvm//:bin/llvm-ar",
)

# CMake `kernel_locking_built-in` (static library)
# sources with flags of their own (a define or two each): per_source_copts
# per-source KBUILD_* defines computed from the sources (kbuild); the map, when it remains, is what the arithmetic cannot express
cc_per_source_library(
    name = "kernel_locking_built_in",
    srcs = [
        "mutex.c",
        "osq_lock.c",
        "percpu-rwsem.c",
        "qrwlock.c",
        "qspinlock.c",
        "rtmutex_api.c",
        "rwsem.c",
        "semaphore.c",
        "spinlock.c",
    ],
    copts = [
        "-Ikernel/locking",
        "-I$(GENDIR)",
    ],
    deps = [
        ":locking_headers",
        "//:pkg_headers",
        "//:pkg_generated_under_arch_x86__include_generated_2",
        "//kernel:kernel_headers",
    ],
    features = ["kernel_compile_flags"],
    kbuild = "built-in",
)
