# kernel/locking: BUILD.bazel emitted by any2bazel emit_build.py from the reference model.
#
# Derived mechanically from model.capture.json (re-run the emitter
# rather than editing the derived parts by hand; the differ is the oracle):
#   kernel_locking_built-in (static_library) -> cc_library kernel_locking_built_in
load("//bazel/rules:cc_object_files.bzl", "cc_object_files")
load("//bazel/rules:kernel_library.bzl", "kernel_library")
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# Every header of this package its TUs can reach (Bazel only puts
# declared files in the compile sandbox); hdrs alone add no include
# root, so nothing is shadowed.
cc_library(
    name = "locking_headers",
    hdrs = glob([
        "**/*.h",
        "**/*.hh",
        "**/*.hpp",
        "**/*.hxx",
        "**/*.inc",
        "**/*.inl",
        "**/*.ipp",
    ], exclude = [
        "rtmutex.c",
        "rwbase_rt.c",
    ], allow_empty = True),
    textual_hdrs = [
        "rtmutex.c",
        "rwbase_rt.c",
    ],
)

# the object(s) of `kernel_locking_built_in` a recipe reads, at the paths it names
cc_object_files(
    name = "kernel_locking_built_in_objects",
    lib = ":kernel_locking_built_in",
    objects = [
        "mutex.o",
        "osq_lock.o",
        "percpu-rwsem.o",
        "qrwlock.o",
        "qspinlock.o",
        "rtmutex_api.o",
        "rwsem.o",
        "semaphore.o",
        "spinlock.o",
    ],
)

# the library, its archive (the reference's own ar recipe: members
# in its order, which is the link order) and the objects a recipe
# reads by path: the macro owns the archive
kernel_library(
    name = "kernel_locking_built_in",
    srcs = [
        "mutex.c",
        "osq_lock.c",
        "percpu-rwsem.c",
        "qrwlock.c",
        "qspinlock.c",
        "rtmutex_api.c",
        "rwsem.c",
        "semaphore.c",
        "spinlock.c",
    ],
    copts = [
        "-Ikernel/locking",
        "-I$(GENDIR)",
    ],
    deps = [
        ":locking_headers",
        "//:pkg_headers",
        "//:pkg_generated_under_arch_x86__include_generated_2",
        "//kernel:kernel_headers",
    ],
    features = ["kernel_compile_flags"],
    kbuild = "built-in",
    out = "built-in.a",
    op = "cDPrST",
    members = [
        "mutex.o",
        "semaphore.o",
        "rwsem.o",
        "percpu-rwsem.o",
        "spinlock.o",
        "osq_lock.o",
        "qspinlock.o",
        "rtmutex_api.o",
        "qrwlock.o",
    ],
    ar = "@kernel_llvm//:bin/llvm-ar",
)
