load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")

package(default_visibility = ["//visibility:public"])

# Every header of this package its TUs can reach (Bazel only puts
# declared files in the compile sandbox); hdrs alone add no include
# root, so nothing is shadowed.
cc_library(
    name = "realmode_headers",
    hdrs = glob([
        "**/*.h",
        "**/*.hh",
        "**/*.hpp",
        "**/*.hxx",
        "**/*.inc",
        "**/*.inl",
        "**/*.ipp",
    ], allow_empty = True),
)

# the object(s) of `arch_x86_realmode_built_in` a recipe reads, at the paths it names
cc_object_files(
    name = "arch_x86_realmode_built_in_objects",
    lib = ":arch_x86_realmode_built_in",
    objects = ["init.o"],
)

# the object(s) of `arch_x86_realmode_built_in_rmpiggy` a recipe reads, at the paths it names
cc_object_files(
    name = "arch_x86_realmode_built_in_rmpiggy_objects",
    lib = ":arch_x86_realmode_built_in_rmpiggy",
    objects = ["rmpiggy.o"],
)

# the reference's own ar recipe: members in its order, which is
# the link order (an aggregate's merge order is Bazel's, not the
# reference's)
ar_archive(
    name = "arch_x86_realmode_built_in_a",
    out = "built-in.a",
    op = "cDPrST",
    members = [
        "init.o",
        "rmpiggy.o",
    ],
    srcs = [
        "init.o",
        "rmpiggy.o",
    ],
    ar = "@kernel_llvm//:bin/llvm-ar",
)

