    ],
    features = ["kernel_compile_flags"],
    kbuild = "built-in",
    out = "built-in.a",
    op = "cDPrST",
    members = [
        "i386.o",
        "init.o",
        "direct.o",
        "fixup.o",
        "legacy.o",
        "irq.o",
        "common.o",
        "early.o",
