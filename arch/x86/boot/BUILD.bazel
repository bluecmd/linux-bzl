package(default_visibility = ["//visibility:public"])


# Every header of this package its TUs can reach (Bazel only puts
# declared files in the compile sandbox); hdrs alone add no include
# root, so nothing is shadowed.
cc_library(
    name = "boot_headers",
    hdrs = glob([
        "**/*.h",
        "**/*.hh",
        "**/*.hpp",
        "**/*.hxx",
        "**/*.inc",
        "**/*.inl",
        "**/*.ipp",
    ], exclude = [
        "cmdline.c",
        "cpuflags.c",
        "string.c",
    ], allow_empty = True),
    textual_hdrs = [
        "cmdline.c",
        "cpuflags.c",
        "string.c",
    ],
)

# host tool the reference builds with `clang` (host tool run by mkcpustr); listed
# under a genrule's `tools`, Bazel builds it for the exec platform
cc_binary(
    name = "mkcpustr",
    srcs = [
        "mkcpustr.c",
        "//:include/generated/autoconf.h",
    ],
    copts = [
        "-Wstrict-prototypes",
        "-O2",
        "-Iscripts/include",
        "-Itools/include",
        "-include",
        "$(GENDIR)/include/generated/autoconf.h",
        "-D__EXPORTED_HEADERS__",
        "-Iarch/x86/boot",
        "-I$(GENDIR)/arch/x86/boot",
        "-fuse-ld=lld",
        "-iquote$(GENDIR)/arch/x86/kernel",
    ],
    deps = [
        ":boot_headers",
        "//:pkg_headers",
        "//:mkcpustr_textual",
        "//arch/x86:x86_headers",
        "//scripts:scripts_headers",
    ],
    tags = ["manual"],
)

