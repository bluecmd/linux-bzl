        "noexecstack",
        "-T",
        "$(location setup.ld)",
        "--whole-archive",
        "$(location :setup.elf_objs)",
        "--no-whole-archive",
    ],
    srcs = ["setup.ld"],
    deps = [":setup.elf_objs"],
)
