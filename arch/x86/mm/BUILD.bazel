# arch/x86/mm: BUILD.bazel emitted by any2bazel emit_build.py from the reference model.
#
# Derived mechanically from model.capture.json (re-run the emitter
# rather than editing the derived parts by hand; the differ is the oracle):
#   arch_x86_mm_built-in (static_library) -> cc_library arch_x86_mm_built_in
load("//bazel/rules:ar_archive.bzl", "ar_archive")
load("//bazel/rules:cc_object_files.bzl", "cc_object_files")
load("//bazel/rules:cc_per_source_library.bzl", "cc_per_source_library")
load("//bazel/rules:cc_raw_link.bzl", "cc_raw_link")
load("//bazel/rules:tree_recipe.bzl", "tree_recipe")
load("@rules_cc//cc:cc_static_library.bzl", "cc_static_library")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")

package(default_visibility = ["//visibility:public"])

# Every header of this package its TUs can reach (Bazel only puts
# declared files in the compile sandbox); hdrs alone add no include
# root, so nothing is shadowed.
cc_library(
    name = "mm_headers",
    hdrs = glob([
        "**/*.h",
        "**/*.hh",
        "**/*.hpp",
        "**/*.hxx",
        "**/*.inc",
        "**/*.inl",
        "**/*.ipp",
    ], exclude = ["ident_map.c"], allow_empty = True),
    textual_hdrs = ["ident_map.c"],
)

# the object(s) of `arch_x86_mm_built_in` a recipe reads, at the paths it names
cc_object_files(
    name = "arch_x86_mm_built_in_objects",
    lib = ":arch_x86_mm_built_in",
    objects = [
        "cpu_entry_area.o",
        "extable.o",
        "fault.o",
        "init.o",
        "init_64.o",
        "ioremap.o",
        "maccess.o",
        "mmap.o",
        "pgprot.o",
        "pgtable.o",
        "physaddr.o",
        "pkeys.o",
        "tlb.o",
    ],
)

# the reference's own ar recipe: members in its order, which is
# the link order (an aggregate's merge order is Bazel's, not the
# reference's)
ar_archive(
    name = "arch_x86_mm_built_in_a",
    out = "built-in.a",
    op = "cDPrST",
    members = [
        "init.o",
        "init_64.o",
        "fault.o",
        "ioremap.o",
        "extable.o",
        "mmap.o",
        "pgtable.o",
        "physaddr.o",
        "tlb.o",
        "cpu_entry_area.o",
        "maccess.o",
        "pgprot.o",
        "//arch/x86/mm/pat:arch_x86_mm_pat_built_in_a",
        "pkeys.o",
    ],
    srcs = [
        "init.o",
        "init_64.o",
        "fault.o",
        "ioremap.o",
        "extable.o",
        "mmap.o",
        "pgtable.o",
        "physaddr.o",
        "tlb.o",
        "cpu_entry_area.o",
        "maccess.o",
        "pgprot.o",
        "//arch/x86/mm/pat:arch_x86_mm_pat_built_in_a",
        "pkeys.o",
        "//arch/x86/mm/pat:memtype.o",
        "//arch/x86/mm/pat:set_memory.o",
    ],
    ar = "@kernel_llvm//:bin/llvm-ar",
)

# CMake `arch_x86_mm_built-in` (static library)
# sources with flags of their own (a define or two each): per_source_copts
# per-source KBUILD_* defines computed from the sources (kbuild); the map, when it remains, is what the arithmetic cannot express
cc_per_source_library(
    name = "arch_x86_mm_built_in",
    srcs = [
        "cpu_entry_area.c",
        "extable.c",
        "fault.c",
        "init.c",
        "init_64.c",
        "ioremap.c",
        "maccess.c",
        "mmap.c",
        "pgprot.c",
        "pgtable.c",
        "physaddr.c",
        "pkeys.c",
        "tlb.c",
    ],
    copts = [
        "-Iarch/x86/mm",
        "-I$(GENDIR)",
    ],
    deps = [
        "//mm:mm_headers",
        "//:pkg_headers",
        "//:pkg_generated_under_arch_x86__include_generated_2",
        "//arch/x86:x86_headers",
    ],
    features = ["kernel_compile_flags"],
    kbuild = "built-in",
)
