# arch/x86/tools: BUILD.bazel emitted by any2bazel emit_build.py from the reference model.
#
# Derived mechanically from model.capture.json (re-run the emitter
# rather than editing the derived parts by hand; the differ is the oracle):
load("//bazel/rules:ar_archive.bzl", "ar_archive")
load("//bazel/rules:cc_object_files.bzl", "cc_object_files")
load("//bazel/rules:cc_per_source_library.bzl", "cc_per_source_library")
load("//bazel/rules:cc_raw_link.bzl", "cc_raw_link")
load("//bazel/rules:tree_recipe.bzl", "tree_recipe")
load("@rules_cc//cc:cc_static_library.bzl", "cc_static_library")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")

package(default_visibility = ["//visibility:public"])
exports_files([
    "cpufeaturemasks.awk",
    "gen-insn-attr-x86.awk",
])


# Every header of this package its TUs can reach (Bazel only puts
# declared files in the compile sandbox); hdrs alone add no include
# root, so nothing is shadowed.
cc_library(
    name = "tools_headers",
    hdrs = glob([
        "**/*.h",
        "**/*.hh",
        "**/*.hpp",
        "**/*.hxx",
        "**/*.inc",
        "**/*.inl",
        "**/*.ipp",
    ], exclude = ["relocs.c"], allow_empty = True),
    textual_hdrs = ["relocs.c"],
)

# host tool the reference builds with `clang` (host tool run by relocs); listed
# under a genrule's `tools`, Bazel builds it for the exec platform
cc_binary(
    name = "relocs",
    srcs = [
        "relocs_32.c",
        "relocs_64.c",
        "relocs_common.c",
    ],
    copts = [
        "-Wstrict-prototypes",
        "-O2",
        "-Iscripts/include",
        "-Itools/include",
        "-Iinclude/uapi",
        "-Iarch/include/uapi",
        "-Iarch/x86/tools",
        "-fuse-ld=lld",
    ],
    deps = [
        ":tools_headers",
        "//:pkg_headers",
        "//arch/x86:x86_headers",
        "//scripts:scripts_headers",
    ],
    tags = ["manual"],
)

# host tool the reference builds with `clang` (host tool run by vdso2c); listed
# under a genrule's `tools`, Bazel builds it for the exec platform
cc_binary(
    name = "vdso2c",
    srcs = ["vdso2c.c"],
    copts = [
        "-Wstrict-prototypes",
        "-O2",
        "-Iscripts/include",
        "-Itools/include",
        "-Iinclude/uapi",
        "-Iarch/include/uapi",
        "-Iarch/x86/tools",
        "-fuse-ld=lld",
    ],
    deps = [
        ":tools_headers",
        "//:pkg_headers",
        "//arch/x86:x86_headers",
        "//scripts:scripts_headers",
    ],
    tags = ["manual"],
)
