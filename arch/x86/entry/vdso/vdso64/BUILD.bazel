    name = "arch_x86_entry_vdso_vdso64_built_in_objects",
    lib = "//:arch_x86_entry_vdso_vdso64_built_in",
    objects = ["vdso64-image.o"],
)

# the reference's own ar recipe: members in its order, which is
# the link order (an aggregate's merge order is Bazel's, not the
# reference's)
ar_archive(
    name = "arch_x86_entry_vdso_vdso64_built_in_a",
    out = "built-in.a",
    op = "cDPrST",
    members = ["vdso64-image.o"],
    srcs = ["vdso64-image.o"],
    ar = "@kernel_llvm//:bin/llvm-ar",
)

# binutils @ None: arch/x86/entry/vdso/vdso64/vdso64.so
