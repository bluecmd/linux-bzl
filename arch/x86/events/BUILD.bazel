# arch/x86/events: BUILD.bazel emitted by any2bazel emit_build.py from the reference model.
#
# Derived mechanically from model.capture.json (re-run the emitter
# rather than editing the derived parts by hand; the differ is the oracle):
#   arch_x86_events_built-in (static_library) -> cc_library arch_x86_events_built_in
load("//bazel/rules:ar_archive.bzl", "ar_archive")
load("//bazel/rules:cc_object_files.bzl", "cc_object_files")
load("//bazel/rules:cc_per_source_library.bzl", "cc_per_source_library")
load("//bazel/rules:cc_raw_link.bzl", "cc_raw_link")
load("//bazel/rules:tree_recipe.bzl", "tree_recipe")
load("@rules_cc//cc:cc_static_library.bzl", "cc_static_library")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")

package(default_visibility = ["//visibility:public"])
exports_files([
    "Kconfig",
])


# Every header of this package its TUs can reach (Bazel only puts
# declared files in the compile sandbox); hdrs alone add no include
# root, so nothing is shadowed.
cc_library(
    name = "events_headers",
    hdrs = glob([
        "**/*.h",
        "**/*.hh",
        "**/*.hpp",
        "**/*.hxx",
        "**/*.inc",
        "**/*.inl",
        "**/*.ipp",
    ], allow_empty = True),
)

# the object(s) of `arch_x86_events_built_in` a recipe reads, at the paths it names
cc_object_files(
    name = "arch_x86_events_built_in_objects",
    lib = ":arch_x86_events_built_in",
    objects = [
        "core.o",
        "msr.o",
        "probe.o",
        "rapl.o",
        "utils.o",
    ],
)

# the reference's own ar recipe: members in its order, which is
# the link order (an aggregate's merge order is Bazel's, not the
# reference's)
ar_archive(
    name = "arch_x86_events_built_in_a",
    out = "built-in.a",
    op = "cDPrST",
    members = [
        "core.o",
        "probe.o",
        "utils.o",
        "rapl.o",
        "//arch/x86/events/amd:arch_x86_events_amd_built_in_a",
        "msr.o",
        "//arch/x86/events/intel:arch_x86_events_intel_built_in_a",
        "//arch/x86/events/zhaoxin:arch_x86_events_zhaoxin_built_in_a",
    ],
    srcs = [
        "core.o",
        "probe.o",
        "utils.o",
        "rapl.o",
        "//arch/x86/events/amd:arch_x86_events_amd_built_in_a",
        "msr.o",
        "//arch/x86/events/intel:arch_x86_events_intel_built_in_a",
        "//arch/x86/events/zhaoxin:arch_x86_events_zhaoxin_built_in_a",
        "//arch/x86/events/amd:ibs.o",
        "//arch/x86/events/amd:lbr.o",
        "//arch/x86/events/amd:core.o",
        "//arch/x86/events/intel:cstate.o",
        "//arch/x86/events/intel:uncore_discovery.o",
        "//arch/x86/events/intel:uncore_snbep.o",
        "//arch/x86/events/intel:uncore_snb.o",
        "//arch/x86/events/intel:uncore_nhmex.o",
        "//arch/x86/events/intel:uncore.o",
        "//arch/x86/events/intel:pt.o",
        "//arch/x86/events/intel:p6.o",
        "//arch/x86/events/intel:p4.o",
        "//arch/x86/events/intel:lbr.o",
        "//arch/x86/events/intel:knc.o",
        "//arch/x86/events/intel:ds.o",
        "//arch/x86/events/intel:bts.o",
        "//arch/x86/events/intel:core.o",
        "//arch/x86/events/zhaoxin:core.o",
    ],
    ar = "@kernel_llvm//:bin/llvm-ar",
)

# CMake `arch_x86_events_built-in` (static library)
# sources with flags of their own (a define or two each): per_source_copts
# per-source KBUILD_* defines computed from the sources (kbuild); the map, when it remains, is what the arithmetic cannot express
cc_per_source_library(
    name = "arch_x86_events_built_in",
    srcs = [
        "core.c",
        "msr.c",
        "probe.c",
        "rapl.c",
        "utils.c",
    ],
    copts = [
        "-Iarch/x86/events",
        "-I$(GENDIR)",
    ],
    deps = [
        "//kernel/events:events_headers",
        "//:pkg_headers",
        "//:pkg_generated_under_arch_x86__include_generated_2",
        "//arch/x86:x86_headers",
    ],
    features = ["kernel_compile_flags"],
    kbuild = "built-in",
)
