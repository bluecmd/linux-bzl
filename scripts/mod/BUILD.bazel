# scripts/mod: BUILD.bazel emitted by any2bazel emit_build.py from the reference model.
#
# Derived mechanically from model.capture.json (re-run the emitter
# rather than editing the derived parts by hand; the differ is the oracle):
#   scripts_mod_empty (object_library) -> cc_library scripts_mod_empty
#
# Notes:
#   - `scripts_mod_empty`: scripts/mod/empty.c compiled for a recipe that reads its object
#     (scripts/mod/empty.o); cc_object_files hands the object out
#   - `arch_x86_boot_startup_gdt_idt`: arch/x86/boot/startup/gdt_idt.c compiled for a recipe
#     that reads its object (arch/x86/boot/startup/gdt_idt.o); cc_object_files hands the object
#     out
#   - `arch_x86_boot_startup_map_kernel`: arch/x86/boot/startup/map_kernel.c compiled for a
#     recipe that reads its object (arch/x86/boot/startup/map_kernel.o); cc_object_files hands
#     the object out
#   - `vmlinux_export`: .vmlinux.export.c compiled for a recipe that reads its object
#     (.vmlinux.export.o); cc_object_files hands the object out
#   - `init_version_timestamp`: init/version-timestamp.c compiled for a recipe that reads its
#     object (init/version-timestamp.o); cc_object_files hands the object out
#   - unknown-role target `<unlinked>` (object_library) not emitted
#   - devicetable_offsets_s: the generator depends on its working directory; the tree_recipe
#     rule mirrors it under the output tree and runs the recipe from .
#   - elfconfig_h: the recipe runs as a tool_stdout rule (recipe kind `tool_stdout`)
#   - devicetable_offsets_h: the recipe runs as a offsets_header rule (recipe kind `offsets`)
load("//bazel/rules:cc_object_files.bzl", "cc_object_files")
load("//bazel/rules:kbuild_env.bzl", "COMMON_ENV")
load("//bazel/rules:offsets_header.bzl", "offsets_header")
load("//bazel/rules:tool_stdout.bzl", "tool_stdout")
load("//bazel/rules:tree_recipe.bzl", "tree_recipe")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")

package(default_visibility = ["//visibility:public"])


# Every header of this package its TUs can reach (Bazel only puts
# declared files in the compile sandbox); hdrs alone add no include
# root, so nothing is shadowed.
cc_library(
    name = "mod_headers",
    hdrs = glob([
        "**/*.h",
        "**/*.hh",
        "**/*.hpp",
        "**/*.hxx",
        "**/*.inc",
        "**/*.inl",
        "**/*.ipp",
    ], allow_empty = True),
)

# host tool the reference builds with `clang` (host tool run by mk_elfconfig); listed
# under a genrule's `tools`, Bazel builds it for the exec platform
cc_binary(
    name = "mk_elfconfig",
    srcs = ["mk_elfconfig.c"],
    copts = [
        "-Wstrict-prototypes",
        "-O2",
        "-Iscripts/include",
        "-Iscripts/mod",
        "-I$(GENDIR)/scripts/mod",
        "-fuse-ld=lld",
    ],
    deps = [
        ":mod_headers",
        "//:pkg_headers",
        "//scripts:scripts_headers",
    ],
    tags = ["manual"],
)

# host tool the reference builds with `clang` (host tool run by modpost); listed
# under a genrule's `tools`, Bazel builds it for the exec platform
cc_binary(
    name = "modpost",
    srcs = [
        "modpost.c",
        "file2alias.c",
        "sumversion.c",
        "symsearch.c",
        "devicetable-offsets.h",
        "elfconfig.h",
    ],
    copts = [
        "-Wstrict-prototypes",
        "-O2",
        "-Iscripts/include",
        "-Iscripts/mod",
        "-I$(GENDIR)/scripts/mod",
        "-fuse-ld=lld",
    ],
    deps = [
        ":mod_headers",
        "//:pkg_headers",
        "//scripts:scripts_headers",
    ],
    tags = ["manual"],
)

# the object(s) of `scripts_mod_empty` a recipe reads, at the paths it names
cc_object_files(
    name = "scripts_mod_empty_objects",
    lib = ":scripts_mod_empty",
    objects = ["empty.o"],
)

# sh @ recipe line: scripts/mod/devicetable-offsets.h
# Kbuild's offsets step: the sed Makefile.lib's `sed-offsets`
# runs, the header restamped only when its bytes change
offsets_header(
    name = "devicetable_offsets_h",
    src = "devicetable-offsets.s",
    outs = ["devicetable-offsets.h"],
    guard = "__DEVICETABLE_OFFSETS_H__",
)

