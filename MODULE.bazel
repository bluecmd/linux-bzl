module(name = "linux_bzl", version = "0.1.0")

bazel_dep(name = "rules_cc", version = "0.2.25")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "zlib", version = "1.3.1.bcr.3")
bazel_dep(name = "rules_m4", version = "0.3.bcr.1")
bazel_dep(name = "rules_flex", version = "0.4.1")
bazel_dep(name = "rules_bison", version = "0.4.bcr.1")
bazel_dep(name = "toolchains_llvm", version = "1.11.0")

# The one compiler on both sides: the reference build is `make LLVM=1` with
# this release; Bazel's host (exec) cc toolchain is the same release, and the
# kernel cc toolchain (//toolchain) points at the same binaries.
llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")
llvm.toolchain(llvm_version = "22.1.8")
use_repo(llvm, "llvm_toolchain", "llvm_toolchain_llvm")

# The kernel cc toolchain: a repository linking that distribution's tools
# (package-relative tool_paths, so genrules get $(NM)/$(LD)/$(OBJCOPY)); its
# compile line is //toolchain:kernel_flags.bzl, written by any2bazel's
# probe_kernel.py --common from the recorded reference build.
kernel_llvm_toolchain = use_repo_rule("//bazel/rules:kernel_llvm_toolchain.bzl", "kernel_llvm_toolchain")
kernel_llvm_toolchain(
    name = "kernel_llvm",
    clang = "@llvm_toolchain_llvm//:bin/clang",
    config_bzl = "//bazel/rules:kernel_cc_toolchain_config.bzl",
    files = [
        "@llvm_toolchain_llvm//:bin",
        "@llvm_toolchain_llvm//:include",
        "@llvm_toolchain_llvm//:lib",
    ],
    flags_bzl = "//toolchain:kernel_flags.bzl",
    include_roots_symbol = "KERNEL_INCLUDE_ROOTS",
    # The kernel's own TUs are -nostdinc (KERNEL_INCLUDE_ROOTS above is all
    # they search); the host-support code this toolchain also compiles (the
    # objtool support library) reads the compiler's builtins and the host
    # system headers, as the reference build did. The compiler's own resource
    # dirs it declares itself (kernel_llvm_toolchain derives them from the
    # compiler's real path); the system headers are spelled the way
    # toolchains_llvm declares them.
    builtin_include_directories = [
        "/usr/include",
        "/usr/local/include",
    ],
    include_dirs_symbol = "",
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
        "//platforms:kernel",
    ],
    target_cpu = "x86_64",
    target_system_name = "x86_64-linux-gnu",
)

# the kernel toolchain first: it requires //platforms:kernel, so it is only
# picked for the kernel platform; the plain LLVM toolchain serves the exec platform
register_toolchains("@kernel_llvm//:toolchain", "@llvm_toolchain//:all")

