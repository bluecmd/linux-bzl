# libelf for the objtool host tool: the reference build takes it from the
# machine (-lelf, <gelf.h>); here it is fetched, pinned, and built by the
# same exec toolchain — only the libelf subset is built (see
# bazel/third_party/elfutils.BUILD.bazel).
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
http_archive(
    name = "elfutils",
    build_file = "//bazel/third_party:elfutils.BUILD.bazel",
    sha256 = "09e2ff033d39baa8b388a2d7fbc5390bfde99ae3b7c67c7daaf7433fbcf0f01e",
    strip_prefix = "elfutils-0.194",
    urls = ["https://sourceware.org/elfutils/ftp/0.194/elfutils-0.194.tar.bz2"],
)

# bc for the kernel's timeconst.h generator: the reference took it from the
# machine's PATH; here the pinned source builds it (with upstream's own
# two-stage libmath bootstrap -- see bazel/third_party/bc.BUILD.bazel).
http_archive(
    name = "bc",
    build_file = "//bazel/third_party:bc.BUILD.bazel",
    sha256 = "62adfca89b0a1c0164c2cdca59ca210c1d44c3ffc46daf9931cf4942664cb02a",
    strip_prefix = "bc-1.07.1",
    urls = ["https://ftp.gnu.org/gnu/bc/bc-1.07.1.tar.gz"],
)
